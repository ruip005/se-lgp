# Copiar para .env e ajustar (o .env NÃO vai para o Git)

# --- Edge (PC) ---
LGP_CAMERA_INDEX=0            # integrada = 0, webcam USB costuma ser 1
LGP_CAMERA_WIDTH=640
LGP_CAMERA_HEIGHT=480
LGP_MODEL_PATH=models/hand_landmarker.task
LGP_SERIAL_PORT=              # Windows: COM3 | Linux: /dev/ttyUSB0 ou /dev/ttyACM0 | macOS: /dev/cu.usbmodemXXXX
LGP_SERIAL_BAUD=115200

# --- Serviços Docker (opcionais) ---
POSTGRES_DB=lgp
POSTGRES_USER=lgp
POSTGRES_PASSWORD=muda-esta-password
